    {
      "id": "drag.threshold",
      "value": 4,
      "unit": "screen-px",
      "source": "spec/behavior/drag-reorder-canvas.md",
      "note": "Euclidean pointer movement that turns a press into a drag; below it a release is a click. Shared by canvas, palette and Layers drags, the marquee, resize, spacing and property handles, guides and panel drags. Independent of the zoom."
    },
    {
      "id": "drag.hysteresis",
      "value": 4,
      "unit": "screen-px",
      "source": "spec/behavior/drag-reorder-canvas.md",
      "note": "A new drop decision replaces the drawn one only after the pointer has moved this far from where the drawn one was taken."
    },
    {
