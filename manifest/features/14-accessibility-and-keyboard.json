            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": "fit"
          },
          "steps": [
            {
              "door": "selection.select#layers-row",
              "args": {
                "target": "/Page/Hero"
              },
              "target": "/Page/Hero",
              "drop": null,
              "action": false,
              "hold": false,
              "type": null
            },
            {
              "door": "layers.collapseOrFocusParent#key-arrow-left-in-layers-tree",
              "args": {},
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "layers.collapseOrFocusParent#key-arrow-left-in-layers-tree"
          ],
          "expect": {
            "document": [],
            "selection": [
              "/Page/Hero"
            ],
            "history": {
              "undoSteps": 0,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
