{
  "group": "page-and-export",
  "titleKey": "featureGroup.pageAndExport",
  "features": [
    {
      "id": "page-properties",
      "titleKey": "feature.pageProperties",
      "commands": [
        "page.openProperties",
        "page.setSetting"
      ],
      "dependsOn": [
        "inspector-panel"
      ],
      "spec": "spec/behavior/page-properties.md",
      "intent": {
        "title": "Page properties: title, language, direction and page styles",
        "steps": [
          "Click Page in the top bar (or Page properties in the empty inspector).",
          "Set the title 'Landing', language 'pt-BR', direction rtl.",
          "Set the page background colour, text colour and base font."
        ],
        "expected": [
          "The Page root is selected and the inspector shows page settings above the page styles.",
          "Title, language and direction are stored in the page settings of the document JSON; the iframe html element gets lang and dir.",
          "Page background, colour and font are stored on the Page root styles and computed in the iframe."
        ]
      },
      "scenarios": [
        {
          "id": "page-properties-selects-the-page-root-and-shows-its-settings",
          "setup": {
            "fixture": "aurora",
            "selection": [
              "/Page/Hero/Intro"
            ],
            "context": "global",
            "breakpoint": "desktop",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": "fit"
          },
          "steps": [
            {
              "door": "page.openProperties#inspector-page-properties-button",
              "args": {},
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "page.openProperties#inspector-page-properties-button"
          ],
          "expect": {
            "document": [],
            "selection": [
              "/Page"
            ],
            "history": {
              "undoSteps": 0,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
              "geometry": [],
              "feedback": [
                {
                  "key": "status.selected",
                  "params": {
                    "name": "Page"
                  }
                }
              ]
            },
            "editor": {
              "regions": [
                {
                  "region": "inspector-settings",
                  "measure": "height",
                  "relation": "greater-than",
                  "value": 0,
                  "reference": null
                }
              ],
              "computed": []
            },
            "persistence": null,
            "export": null
          },
          "refusals": []
        },
