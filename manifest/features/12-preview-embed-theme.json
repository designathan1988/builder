          "refusals": []
        }
      ]
    },
    {
      "id": "theme-switch",
      "titleKey": "feature.themeSwitch",
      "commands": [
        "preferences.setTheme"
      ],
      "dependsOn": [],
      "spec": null,
      "intent": {
        "title": "Light, dark and system theme",
        "steps": [
          "Choose Theme > Light, then Dark, then System.",
          "With System chosen, switch the OS/browser colour scheme emulation.",
          "Reload."
        ],
        "expected": [
          "The editor chrome switches its colour tokens; the page inside the iframe keeps its own colours.",
          "System follows prefers-color-scheme live.",
          "The choice is stored in the preferences store and restored after reload."
        ]
      },
      "scenarios": []
    }
  ]
}
