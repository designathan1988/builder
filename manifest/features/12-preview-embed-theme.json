{
  "group": "preview-embed-theme",
  "titleKey": "featureGroup.previewEmbedTheme",
  "features": [
    {
      "id": "preview-mode",
      "titleKey": "feature.previewMode",
      "commands": [
        "view.setBreakpoint",
        "view.enterPreview",
        "view.exitPreview",
        "project.export"
      ],
      "dependsOn": [
        "state-styles"
      ],
      "spec": "spec/behavior/preview-mode.md",
      "intent": {
        "title": "Preview the page without editor chrome",
        "steps": [
          "Build a page with a Button that has a hover state and a Details element.",
          "Press Ctrl+P (or click Preview).",
          "Hover the button, open the details, switch to Phone.",
          "Press Escape."
        ],
        "expected": [
          "Preview hides docks, selection, guides and handles; only a slim bar with the breakpoint switcher, Exit preview and Export remains.",
          "The page renders exactly like the export: hover states apply and details open; links do not navigate the editor away.",
          "Escape or Ctrl+Enter exits preview and restores the previous selection and zoom.",
          "Preview never changes the document JSON."
        ]
      },
      "scenarios": [
        {
          "id": "ctrl-p-shows-the-page-as-exported",
          "setup": {
            "fixture": "aurora",
            "selection": [
              "/Page/Hero/Intro"
            ],
            "context": "global",
            "breakpoint": "desktop",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": "fit"
          },
          "steps": [
            {
              "door": "view.enterPreview#key-ctrl-p-in-global",
              "args": {},
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "view.enterPreview#key-ctrl-p-in-global"
          ],
          "expect": {
            "document": [],
            "selection": [
              "/Page/Hero/Intro"
            ],
            "history": {
              "undoSteps": 0,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
