    {
      "id": "embed-html",
      "titleKey": "feature.embedHtml",
      "commands": [
        "element.setEmbedMarkup"
      ],
      "dependsOn": [],
      "spec": null,
      "intent": {
        "title": "Embed custom HTML",
        "steps": [
          "Insert an Embed and paste third-party widget markup with a script.",
          "Preview the page.",
          "Export."
        ],
        "expected": [
          "The markup is stored as-is and shown sandboxed on the editing canvas, where its scripts never run.",
          "Preview runs it.",
          "The export writes it verbatim at its place; Layers marks it as an embed."
        ]
      },
      "scenarios": [
        {
          "id": "the-embed-tile-inserts-an-empty-embed",
          "setup": {
            "fixture": "empty",
            "selection": [],
            "context": "global",
            "breakpoint": "desktop",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": "fit"
          },
          "steps": [
            {
              "door": "workspace.setPanelOpen#toolbar-activity-bar-insert",
              "args": {},
              "target": null,
              "drop": null,
              "action": false,
              "hold": false,
              "type": null
            },
            {
              "door": "element.insert#elements-tile",
              "args": {
                "entry": "embed-html"
              },
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "element.insert#elements-tile"
          ],
          "expect": {
            "document": [
              {
                "op": "set",
                "path": "/Page/@children",
                "value": [
                  {
                    "type": "embed",
                    "name": "Embed",
                    "tag": null,
                    "attributes": {},
                    "classes": [],
                    "styles": {},
                    "text": "",
                    "children": []
                  }
                ]
              }
            ],
            "selection": [
              "/Page/Embed"
            ],
            "history": {
              "undoSteps": 1,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
              "geometry": [],
              "feedback": [
                {
                  "key": "status.placed",
                  "params": {
                    "element": "Embed",
                    "parent": "Page",
                    "position": 1,
                    "count": 1
                  }
                }
              ]
            },
            "editor": null,
            "persistence": null,
            "export": null
          },
          "refusals": []
        },
