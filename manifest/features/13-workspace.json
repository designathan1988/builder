        "command-bar"
      ],
      "spec": "spec/behavior/command-bar-set-property.md",
      "intent": {
        "title": "Set a property or jump to it from the command bar",
        "steps": [
          "Select a flex Container, press Ctrl+K, type 'gap 24' and press Enter.",
          "Press Ctrl+K, type 'width 50%' and press Enter.",
          "Press Ctrl+K, type 'border-color' and choose 'Edit property border-color' [command.editProperty]."
        ],
        "expected": [
          "Typing '<property> <value>' offers 'Set <property> to <value>' [command.setProperty]; running it writes the value to the selection in the document JSON as one undo step.",
          "Invalid values are not offered.",
          "'Edit property X' [command.editProperty] opens the section, reveals the field in the inspector and focuses it."
        ]
      },
      "scenarios": []
    },
    {
      "id": "shortcuts-panel",
      "titleKey": "feature.shortcutsPanel",
      "commands": [
        "workspace.setPanelOpen"
      ],
      "dependsOn": [
        "app-menu"
      ],
      "spec": "spec/behavior/shortcuts-panel.md",
      "intent": {
        "title": "Keyboard shortcuts panel generated from the keymap",
        "steps": [
          "Open Help > Keyboard shortcuts."
        ],
        "expected": [
          "The shortcuts open as a tab in the bottom workbench dock; the workbench is closed by default and opens with its first tab.",
          "The panel lists every binding grouped by context (anywhere, on the canvas, while editing text, during a drag, with something in hand, on panels) with keys and a description.",
          "It is rendered from the single keymap table: a unit test adds a binding to the table and the panel shows it without other changes."
        ]
      },
      "scenarios": []
    },
    {
      "id": "workbench-panel",
      "titleKey": "feature.workbenchPanel",
      "commands": [
        "workspace.setPanelOpen",
        "workspace.toggleDeveloperTools",
        "workspace.setWorkbenchState",
        "workspace.setActiveTab"
      ],
      "dependsOn": [],
      "spec": "spec/behavior/workbench-panel.md",
      "intent": {
        "title": "Bottom workbench: tabs, collapse, maximise and developer tools",
        "steps": [
          "Open the Keyboard shortcuts tab; turn on View > Developer tools and switch between the Keyboard shortcuts and Document tabs.",
          "Click 'Show or hide the workbench' [workbench.toggle], then 'Maximize the workbench' [workbench.maximize] and restore it.",
          "Make a change on the canvas; close the Document tab."
        ],
        "expected": [
          "The workbench shows one tab strip; the chosen tab's content fills it; tabs can be closed.",
