    {
      "id": "state-styles",
      "titleKey": "feature.stateStyles",
      "commands": [
        "style.set",
        "view.setBreakpoint",
        "view.setStyleState"
      ],
      "dependsOn": [
        "breakpoint-overrides"
      ],
      "spec": "spec/behavior/state-styles.md",
      "intent": {
        "title": "Style states: hover, focus, active, disabled, invalid and placeholder shown",
        "steps": [
          "Select a Button, choose State Hover and set background colour and opacity.",
          "Choose Focus and set an outline; choose Base.",
          "Switch to Tablet and set a Hover value there.",
          "Export."
        ],
        "expected": [
          "The State menu lists Base, Hover, Focus, Active, Disabled, Invalid and Placeholder shown; while a state is chosen a canvas badge reads 'Editing Hover' [canvas.badge.editingState] and the canvas shows the element with that state's values.",
          "State values are stored per state (and per breakpoint) in the document JSON and do not change the base values.",
          "styles.css contains :hover, :focus and @media rules for them; in the exported page hovering the button changes its computed background."
        ]
      },
      "scenarios": [
