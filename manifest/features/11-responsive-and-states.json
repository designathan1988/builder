    {
      "id": "breakpoints-switch",
      "titleKey": "feature.breakpointsSwitch",
      "commands": [
        "view.setBreakpoint"
      ],
      "dependsOn": [],
      "spec": "spec/behavior/breakpoints-switch.md",
      "intent": {
        "title": "Switch between Desktop, Laptop, Tablet and Phone breakpoints",
        "steps": [
          "Click Laptop, Tablet, Phone and Desktop in the top bar."
        ],
        "expected": [
          "The page width inside the iframe becomes 1180 CSS px for Laptop, 834 for Tablet, 390 for Phone and 1440 for Desktop; in Fit mode the canvas refits the zoom.",
          "The status bar shows the active breakpoint; the buttons show their widths in tooltips.",
          "The breakpoint buttons and the canvas widths read one breakpoint table (a unit test checks it).",
          "The active breakpoint is restored after a reload."
        ]
      },
      "scenarios": [
        {
          "id": "the-laptop-tab-gives-the-page-1180-px",
          "setup": {
            "fixture": "aurora",
            "selection": [],
            "context": "global",
            "breakpoint": "desktop",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": 50
          },
          "steps": [
            {
              "door": "view.setBreakpoint#toolbar-breakpoint-tabs-laptop",
