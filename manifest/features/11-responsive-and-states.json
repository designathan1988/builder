              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "view.setBreakpoint#toolbar-breakpoint-tabs-laptop"
          ],
          "expect": {
            "document": [],
            "selection": [],
            "history": {
              "undoSteps": 0,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
              "geometry": [
                {
                  "node": "/Page/Hero",
                  "measure": "width",
                  "relation": "greater-than",
                  "value": 1163.5,
                  "reference": null
                },
                {
                  "node": "/Page/Hero",
                  "measure": "width",
                  "relation": "less-than",
                  "value": 1164.5,
                  "reference": null
                }
              ],
              "feedback": [
                {
                  "key": "status.breakpointActive",
