    {
      "id": "breakpoint-overrides",
      "titleKey": "feature.breakpointOverrides",
      "commands": [
        "style.set",
        "style.reset",
        "view.setBreakpoint"
      ],
      "dependsOn": [
        "breakpoints-switch"
      ],
      "spec": "spec/behavior/breakpoint-overrides.md",
      "intent": {
        "title": "Style overrides per breakpoint, desktop first",
        "steps": [
          "Select a Heading at Desktop with font size 32px.",
          "Switch to Tablet and set font size 24px; switch to Phone and look at it.",
          "Switch to Desktop and Laptop.",
          "At Tablet reset the override.",
          "Export."
        ],
        "expected": [
          "The Tablet value is stored as an override for tablet in the document JSON; at Tablet and Phone the computed font size is 24px, at Desktop and Laptop 32px.",
          "Fields with an override at the active breakpoint show a badge naming the breakpoint; inherited values show where they come from.",
          "Resetting the override returns Tablet and Phone to 32px.",
          "styles.css contains the base rule and @media (max-width: 834px) with the override, in cascade order.",
          "The export media queries read the same breakpoint table as the buttons and the canvas (unit test)."
        ]
      },
      "scenarios": [
        {
          "id": "a-value-set-at-tablet-is-stored-for-tablet-and-drawn-there",
          "setup": {
            "fixture": "aurora",
            "selection": [
              "/Page/Hero/Title"
            ],
            "context": "global",
            "breakpoint": "tablet",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": 50
          },
          "steps": [
            {
              "door": "style.set#inspector-font-size",
              "args": {
                "property": "font-size",
                "value": "24px"
              },
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": "24\n"
            }
          ],
          "doors": [
            "style.set#inspector-font-size"
          ],
          "expect": {
            "document": [
              {
                "op": "set",
                "path": "/Page/Hero/Title/@styles/tablet/base/font-size",
                "value": "24px"
              }
            ],
            "selection": [
              "/Page/Hero/Title"
            ],
            "history": {
              "undoSteps": 1,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [
                {
                  "node": "/Page/Hero/Title",
                  "property": "font-size",
                  "value": "24px"
                }
